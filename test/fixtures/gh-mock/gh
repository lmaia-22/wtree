#!/usr/bin/env bash
# Mock `gh` for pr_ship.bats. Dispatches on subcommand; behavior is
# controlled entirely by environment variables the test sets before
# invoking wtree, so each test can script exactly the gh responses it
# needs without touching real GitHub. An invocation this mock doesn't
# recognize fails loudly (exit 99) rather than silently no-op'ing, so
# the mock also asserts wtree calls gh with the arguments it expects.
set -euo pipefail

case "${1:-} ${2:-}" in
"auth status")
  # wtree.sh's resolve_gh_account calls:
  #   gh auth status --hostname github.com --json hosts --jq '...'
  # The real --jq filter is ignored here; tests set GH_MOCK_AUTH_ACCOUNTS
  # directly to the lines that filter would have produced: one
  # "<active> <login>" pair per logged-in account, e.g.
  #   $'true personal-account\nfalse work-account'
  printf '%s\n' "${GH_MOCK_AUTH_ACCOUNTS:-true default-account}"
  ;;
"auth token")
  shift 2
  user=""
  prev=""
  for arg in "$@"; do
    [[ "$prev" == "--user" ]] && user="$arg"
    prev="$arg"
  done
  echo "token-for-$user"
  ;;
"api repos/"*)
  # wtree.sh probes each account's token against `gh api repos/<slug>`
  # to find one that can see the repo. GH_MOCK_API_ALLOWED_TOKEN names
  # the one token (from the "auth token" mock above) that should
  # succeed; every other token is treated as lacking access.
  [[ "${GH_TOKEN:-}" == "${GH_MOCK_API_ALLOWED_TOKEN:-}" ]]
  ;;
"pr view")
  shift 2
  [[ "${GH_MOCK_PR_VIEW_FAIL:-0}" == "1" ]] && exit 1

  json_field=""
  prev=""
  for arg in "$@"; do
    [[ "$prev" == "--json" ]] && json_field="$arg"
    prev="$arg"
  done

  case "$json_field" in
  number) echo "${GH_MOCK_PR_NUMBER:-1}" ;;
  title) echo "${GH_MOCK_PR_TITLE:-mock pr}" ;;
  url) echo "${GH_MOCK_PR_URL:-https://example.invalid/pr/1}" ;;
  mergedAt) echo "${GH_MOCK_MERGED_AT:-null}" ;;
  *)
    echo "gh-mock: pr view with unrecognized --json field: $json_field" >&2
    exit 99
    ;;
  esac
  ;;
"pr merge")
  exit "${GH_MOCK_MERGE_EXIT:-0}"
  ;;
"pr create")
  echo "${GH_MOCK_PR_URL:-https://example.invalid/pr/1}"
  ;;
*)
  echo "gh-mock: unexpected invocation: $*" >&2
  exit 99
  ;;
esac
